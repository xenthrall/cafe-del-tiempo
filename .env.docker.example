# Plantilla de entorno para docker-compose (no para desarrollo local con
# `php artisan serve`, que sigue usando SQLite — ver .env.example).
#
# Copia este archivo a `.env` (en el servidor/host de Docker) y ajusta los
# valores antes de levantar `docker compose up`. Ese `.env` no se versiona
# (ver .gitignore) y es distinto del que usarías para desarrollo local en tu
# máquina — no mezcles ambos flujos en el mismo checkout del repo.

APP_NAME="Café del Tiempo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:9000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cafe_del_tiempo
DB_USERNAME=cafe_del_tiempo
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
